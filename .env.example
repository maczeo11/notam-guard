# Copy to .env. Nothing here is required — with these defaults the service runs
# on in-process adapters and needs no Postgres, Redis or API key.

# Adapters: pgvector|memory and rule|groq
VECTOR_ADAPTER=memory
LLM_ADAPTER=rule

# Infrastructure (used when the adapters above are set to the real backends)
DATABASE_URL=postgresql://notam:notam@localhost:5432/notam
REDIS_URL=redis://localhost:6379/0

# Where approval tickets live: redis (in-process if unreachable) or dynamodb.
# DynamoDB needs AWS credentials (an instance role, or a profile) and an existing table
# with partition key `pk` (string) and TTL on `expires_at`. See deploy/README.md.
TICKET_STORE=redis
# DYNAMODB_TABLE=notam-guard-tickets
# AWS_REGION=ap-south-1

# Corpus and retrieval
NOTAM_DIR=data/notams
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_K=3

# Safety policy
MAX_AGL_M=120
HUMAN_GATE_CONFIDENCE=0.75
TICKET_TTL_SECONDS=86400

# LLM provider (only needed when LLM_ADAPTER=groq)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=notam-guard

LOG_LEVEL=INFO
