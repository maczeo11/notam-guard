[Unit]
Description=NOTAM-Guard API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/notam-guard
Environment=VECTOR_ADAPTER=memory
Environment=LLM_ADAPTER=rule
# Deliberately empty: tickets stay in this process. The endpoint is public and
# unauthenticated, and the Redis on this box also serves another app, so a flood of
# requests must not be able to write into it. If the service is flooded, the
# MemoryMax below restarts it and clears the tickets. (An unreachable or empty
# REDIS_URL makes the app fall back to in-process storage.)
Environment=REDIS_URL=
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/notam-guard/.venv/bin/uvicorn src.app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3s

# The box is shared with other services, so keep this one small and contained.
MemoryMax=300M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
