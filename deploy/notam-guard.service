[Unit]
Description=NOTAM-Guard API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/notam-guard
Environment=VECTOR_ADAPTER=memory
Environment=LLM_ADAPTER=rule
# Approval tickets live in DynamoDB. The VM's instance role (notam-guard-vm) can reach
# only this table, and the table's 5/5 provisioned capacity throttles a flood instead of
# billing it. If the table or the role is wrong, the app logs an error and keeps tickets
# in the process rather than failing to start.
Environment=TICKET_STORE=dynamodb
Environment=DYNAMODB_TABLE=notam-guard-tickets
Environment=AWS_REGION=ap-south-1
# Deliberately empty: the Redis on this box also serves another app, and this endpoint is
# public and unauthenticated, so a flood of requests must not be able to write into it.
# An empty REDIS_URL keeps the per-drone history in the process.
Environment=REDIS_URL=
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/notam-guard/.venv/bin/uvicorn src.app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3s

# The box is shared with other services, so keep this one small and contained.
MemoryMax=300M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
